#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 Brad Anderson
#
# Verifies, from inside the VM, that the hypervisor's firewall is applied.
#
# It cannot read those rules. They live on the node, applied to this VM's tap
# device, which is exactly what makes them worth having and exactly what makes
# them unverifiable by inspection from here. Assuming they are in force is the
# failure this whole family of tools exists to prevent, so this tests behaviour
# instead.
#
# The target is the default gateway, and that choice does three jobs at once:
#
#   - its address is already in the routing table, so naming it writes down
#     nothing an attacker on this box could not already read;
#   - it is guaranteed to be alive, which no arbitrary address is;
#   - it sits inside the ranges the firewall drops, so with the rules applied
#     it must be unreachable as a destination, while traffic *through* it to
#     the internet is untouched.
#
# Nothing here is persisted. A file listing what this VM must not reach would
# be a map of valuable targets kept on the machine most likely to be owned, and
# would describe topology not otherwise obtainable from here without loud
# scanning. There is no such file and there should never be one.

set -euo pipefail

PROG=${0##*/}
CONF_DIR=${CONF_DIR:-/etc/dejima-devbox}

# What lateral movement actually uses, and what a gateway is most likely to
# answer on. Not 53: the resolver exception may legitimately allow it, so a
# rule working exactly as designed would read as a failure.
PROBE_PORTS=(443 80 22)
PROBE_TIMEOUT=${PROBE_TIMEOUT:-3}

say() { printf '%s\n' "$*" >&2; }

default_gateway() {
    local gw
    gw=$(ip -4 route show default 2>/dev/null | awk '{print $3; exit}')
    [ -n "$gw" ] || return 1
    printf '%s\n' "$gw"
}

# open     - handshake completed. Definitely reachable.
# answered - refused, or unreachable. Something replied, so not silently
#            dropped, which is the only thing that counts as contained.
# timeout  - nothing came back.
#
# The open/answered split does not change the verdict; both are definite. It is
# kept because it is free and it tells the operator what they are looking at.
#
# KNOWN LIMIT: bash's /dev/tcp cannot tell ECONNREFUSED from EHOSTUNREACH, so a
# firewall that REJECTs rather than DROPs looks the same as a live host that
# refused. Both land in `answered` and both produce FAIL. That is the safe
# direction to be wrong in - it fails closed, and it is loud - but it means the
# rules must use DROP for a correct PASS. proxmox/firewall.fw.template specifies
# DROP, and this is one of the reasons.
probe_tcp() {
    local host=$1 port=$2 rc=0
    timeout "$PROBE_TIMEOUT" bash -c "exec 3<>/dev/tcp/$host/$port" 2>/dev/null || rc=$?
    case $rc in
        0)   printf 'open\n' ;;
        124) printf 'timeout\n' ;;
        *)   printf 'answered\n' ;;
    esac
}

# FAIL | PASS | INDETERMINATE
#
# Three states rather than two, because a timeout has two causes and reading it
# as a pass is a false negative. False negatives are the wrong direction for a
# security check: the operator stops looking.
gateway_verdict() {
    local gw port result
    if ! gw=$(default_gateway); then
        say "$PROG: no default route, so there is nothing to probe."
        say "  This check carries the exit status on its own, so a missing route"
        say "  is a failure rather than a skip. Fix the route and run again."
        return 2
    fi
    for port in "${PROBE_PORTS[@]}"; do
        result=$(probe_tcp "$gw" "$port")
        case $result in
            open|answered) printf 'FAIL\n'; return 0 ;;
        esac
    done
    if positive_controls_ok; then
        printf 'PASS\n'
    else
        printf 'INDETERMINATE\n'
    fi
}

# The forge's name, from config. Nothing is derived from the network here on
# purpose: an attacker standing on this box can read /etc/dejima-devbox/config
# as easily as we can, so there is no secret to protect and no reason to be
# clever. What matters is that it is one value in one place, matching the rule
# on the hypervisor - see proxmox/README.md, "Values that must agree".
forge_host() {
    local f="$CONF_DIR/config" v=""
    [ -r "$f" ] && v=$(sed -n 's/^forge_host=//p' "$f" | tail -1)
    [ -n "$v" ] || return 1
    printf '%s\n' "$v"
}

resolve_ok() { getent hosts "$1" >/dev/null 2>&1; }

# --- addressing -------------------------------------------------------------
#
# Which mode this host uses decides whether it needs the two DHCP rules on the
# hypervisor, and that question has the nastiest failure in the whole design.
# A DHCP guest behind these rules renews through a path the firewall may be
# dropping. Nothing breaks at boot, because the first lease was obtained before
# the rules mattered. The VM simply stops renewing and falls off the network up
# to a full lease time later, looking nothing like a firewall rule.

INTERFACES_FILE=${INTERFACES_FILE:-/etc/network/interfaces}
LEASE_GLOB=${LEASE_GLOB:-/var/lib/dhcp/dhclient*.leases}

lease_file() {
    local f
    # shellcheck disable=SC2086
    f=$(ls -t $LEASE_GLOB 2>/dev/null | head -1)
    [ -n "$f" ] || return 1
    printf '%s\n' "$f"
}

# static | dhcp | unknown
#
# Static is checked first, and that order is the whole correctness of this
# function. A host pinned by dejima-devbox-static-ip keeps the lease files from
# whatever it was doing before, so letting a lease decide would tell every
# pinned host it needs rules it does not need.
addressing_mode() {
    if [ -r "$INTERFACES_FILE" ] \
       && grep -qE '^[[:space:]]*iface[[:space:]]+\S+[[:space:]]+inet[[:space:]]+static' "$INTERFACES_FILE"; then
        printf 'static\n'; return 0
    fi
    if { [ -r "$INTERFACES_FILE" ] \
         && grep -qE '^[[:space:]]*iface[[:space:]]+\S+[[:space:]]+inet[[:space:]]+dhcp' "$INTERFACES_FILE"; } \
       || lease_file >/dev/null; then
        printf 'dhcp\n'; return 0
    fi
    # Not guessed. An unrecognised setup is a thing to look at, not a thing to
    # assume the friendlier answer about.
    printf 'unknown\n'
}

# dhclient writes "renew 3 2026/08/10 04:12:33;" in UTC. Prints epoch seconds.
lease_time() {  # lease_time FILE KEY
    local v
    v=$(grep -E "^[[:space:]]*$2 " "$1" 2>/dev/null | tail -1 \
        | sed -E "s/^[[:space:]]*$2 [0-9] //; s/;[[:space:]]*$//") || return 1
    [ -n "$v" ] || return 1
    date -u -d "$v" +%s 2>/dev/null || return 1
}

# Does the network demonstrably work?
#
# This is the whole reason a timeout to the gateway can mean anything. If the
# forge resolves or answers, packets are moving and the tap is up, so silence
# from the gateway is a filter. Without that, silence is just silence.
#
# Either control alone is sufficient, and they fail differently on purpose:
# resolution exercises the resolver exception, a handshake exercises layer 4
# and the forge exception. Requiring both would turn an unrelated outage into
# a report the operator learns to ignore.
positive_controls_ok() {
    local host
    host=$(forge_host) || return 1
    resolve_ok "$host" && return 0
    [ "$(probe_tcp "$host" 443)" = open ] && return 0
    return 1
}

cmd_reach() {
    local verdict rc=0
    verdict=$(gateway_verdict) || return $?
    case $verdict in
        PASS)
            say "PASS: the gateway is unreachable, and the network is working."
            say "  Both halves matter. The second is what makes the first mean"
            say "  something rather than being indistinguishable from a dead link."
            ;;
        FAIL)
            say "FAIL: the gateway answered."
            say "  Either the hypervisor rules are not applied to this VM, or an"
            say "  exception above the DROPs is wider than it looks. Check the"
            say "  Network device's Firewall checkbox first, then rule order in the"
            say "  security group - the console inserts new rules at the top, so"
            say "  the documented order has to be built by dragging or entered"
            say "  backwards, and a rule left where it landed does nothing."
            say ""
            say "  One false alarm is possible: if a rule REJECTs rather than DROPs,"
            say "  the block is working but sends an answer back, and this probe"
            say "  cannot tell that from a live host refusing. Use DROP."
            rc=1
            ;;
        INDETERMINATE)
            say "INDETERMINATE: nothing answered, including things that should."
            say "  That is consistent with the firewall working and equally"
            say "  consistent with the network being broken, and this check cannot"
            say "  tell them apart. Fix connectivity, then run again."
            say ""
            say "  It is not a pass. A check that reports success when it does not"
            say "  know is worse than no check, because it gets believed."
            rc=1
            ;;
    esac
    printf '%s\n' "$verdict"
    return $rc
}

# Is the lease actually being renewed?
#
# Detected without keeping any state between runs, which matters: the obvious
# design is to record the expiry each run and see whether it advances, and that
# means this program starts writing files. It does not need to. dhclient
# rewrites the lease file on every successful renewal, so the file's own mtime
# against the renewal time it records answers the question in one pass.
#
# Past T1 with an mtime older than T1 means dhclient asked and got nothing
# back. That is precisely the shape of a dropped reply, and it is visible hours
# before the lease expires and the VM disappears.
lease_report() {
    local f now renew expire
    if ! f=$(lease_file); then
        say "  No lease file found, so renewal cannot be checked here."
        return 0
    fi
    now=$(date -u +%s)
    renew=$(lease_time "$f" renew) || renew=""
    expire=$(lease_time "$f" expire) || expire=""

    if [ -n "$expire" ]; then
        say "  Lease expires in $(( (expire - now) / 3600 ))h."
    fi
    if [ -z "$renew" ]; then
        say "  No renewal time in $f, so renewal cannot be checked."
        return 0
    fi

    if [ "$now" -gt "$renew" ] && [ "$(stat -c %Y "$f" 2>/dev/null || echo 0)" -lt "$renew" ]; then
        say "  THIS LEASE HAS NOT BEEN RENEWED since its renewal time passed."
        say "  dhclient asked and got nothing back, which is what a dropped"
        say "  reply looks like. Check that BOTH DHCP rules are on the"
        say "  hypervisor: the outbound one alone gets the request out and the"
        say "  lease still never completes."
        say "  This is visible now and costs you the network when the lease"
        say "  expires, which is the whole reason it is worth reporting early."
    fi
    return 0
}

# What root on this VM would obtain.
#
# This looks like the target list the audit refuses to keep, and it is not. The
# difference is where the information lives. A list of other hosts describes the
# network beyond this VM, which is not obtainable from here without scanning
# loud enough to notice. An inventory of this box describes a box the attacker
# is already standing on, and reveals nothing a single find would not.
#
# Paths and modes. Never contents.
cmd_radius() {
    local f found=0 newest mode

    say ""
    say "== What root on this VM would get =="

    say ""
    say "Credentials present:"
    for f in "$HOME"/.ssh/id_* "$HOME"/.aws/credentials "$HOME"/.config/gh/hosts.yml \
             "$HOME"/.docker/config.json "$CONF_DIR"/*token*; do
        case "$f" in *.pub) continue ;; esac
        [ -f "$f" ] || continue
        found=1
        say "  $(stat -c '%A %U:%G' "$f" 2>/dev/null)  $f"
    done
    [ "$found" = 1 ] || say "  none found"
    say "  Anything listed here is reusable somewhere else. A scoped deploy"
    say "  token is revoked and reissued; a personal key is every host that"
    say "  trusts it."

    # Listed separately because the advice differs. Everything above can be
    # taken off the box; this cannot, so knowing it is here is the whole of
    # what an operator can do about it.
    say ""
    say "The credential that cannot be moved off:"
    if [ -f "$HOME/.claude/.credentials.json" ]; then
        say "  $(stat -c '%A %U:%G' "$HOME/.claude/.credentials.json" 2>/dev/null)  $HOME/.claude/.credentials.json"
        say "  The model API token. dejima keeps it out of the container, so a"
        say "  session can use the API while it runs and cannot carry the token"
        say "  away. The proxy that holds it runs here, so root here has it."
        say "  That is the step which turns temporary use into a token someone"
        say "  keeps. If this box is ever suspect, rotate this first."
        say ""
        say "  Not because it is the only thing here worth taking - source and"
        say "  uncommitted work leave just as easily - but because it is a"
        say "  standing capability rather than a copy, and it sits at a known"
        say "  path under a known name, which makes it among the easiest things"
        say "  on this box to find."
    else
        say "  no ~/.claude/.credentials.json here. Either this host does not"
        say "  launch sessions, or authentication is by API key held elsewhere."
    fi

    say ""
    say "Group membership:"
    if id 2>/dev/null | grep -q '(docker)'; then
        say "  in the docker group, which is root-equivalent: 'docker run -v /:/host"
        say "  --privileged' is one command and needs no exploit."
        say "  Reported, not corrected. dejima needs it, and separating escape from"
        say "  root was weighed and rejected - see docs/threat-model.md."
    else
        say "  not in the docker group"
    fi

    say ""
    say "Agent memory on this host:"
    if [ -d "$HOME/.claude/projects" ]; then
        say "  $(find "$HOME/.claude/projects" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l) project directories, all of them readable by root here."
        say "  That is what root on this VM reaches, which is this section's"
        say "  subject. What a session inside a container reaches is a separate"
        say "  question, decided by dejima's mounts rather than by anything here."
    else
        say "  no ~/.claude/projects on this host"
    fi

    say ""
    say "Addressing:"
    mode=$(addressing_mode)
    case $mode in
        static)
            say "  static in the guest. Needs no DHCP rules on the hypervisor,"
            say "  which is the tightest of the three modes at the boundary."
            ;;
        dhcp)
            say "  DHCP. The hypervisor needs BOTH halves of the DHCP pair - out"
            say "  udp/67 and in udp/68 - including when the address is reserved"
            say "  for you on the router. A reservation does not stop the guest"
            say "  speaking DHCP."
            lease_report
            ;;
        *)
            say "  could not tell. Neither a static nor a dhcp stanza was found"
            say "  in $INTERFACES_FILE and there is no lease file, so whether"
            say "  this host needs the DHCP rules is an open question."
            ;;
    esac

    say ""
    say "Patch currency:"
    say "  running kernel:   $(uname -r)"
    newest=""
    if command -v dpkg-query >/dev/null 2>&1; then
        # The || true is load-bearing. dpkg-query exits non-zero when nothing
        # matches, and under set -e with pipefail that killed this function
        # halfway through its own report - which looked like the report simply
        # ending, with no error anywhere. Found by running it in a container.
        newest=$(dpkg-query -W -f='${Package}\n' 'linux-image-[0-9]*' 2>/dev/null \
                 | sort -V | tail -1 | sed 's/^linux-image-//' || true)
    fi
    if [ -n "$newest" ]; then
        say "  newest installed: $newest"
        [ "$newest" = "$(uname -r)" ] \
            || say "  THESE DIFFER. A reboot is pending, and the fix is not running."
    else
        # Blank would read as a bug. Say which question went unanswered.
        say "  newest installed: could not tell - no packaged kernel found."
        say "  Expected on a container or an image-based system, and worth a"
        say "  second look on a VM, where it usually means the check is wrong"
        say "  rather than that no kernel is installed."
    fi
    say "  A pending reboot is the usual reason a patched box is not patched."
    say "  Keeping these two equal is the whole of the response to container"
    say "  escape here, so it is not a detail."
    return 0
}

# This program describes the machine it runs on. Run inside a container it
# describes the container, and every reading is real: the gateway is the
# bridge, the credential is whatever is mounted here, the group memberships
# are the image's. None of it is about the devbox, and nothing in the output
# would say so.
#
# DETECTED rather than declared, which is the opposite of test/devbox.bats, and
# the difference is the direction each one fails in. A test that mis-detects
# skips and reports nothing, so it takes a declared variable. This mis-detects
# and prints one extra paragraph. Loud and wrong is cheap; quiet and wrong is
# the thing worth avoiding.
in_container() {
    [ -f /.dockerenv ] && return 0
    [ -f /run/.containerenv ] && return 0
    grep -qaE 'docker|libpod|containerd' /proc/1/cgroup 2>/dev/null && return 0
    return 1
}

# Warn, do not refuse. Someone reading the program's output while developing it
# has a good reason to be here, and refusing would only teach them to work
# around the check.
container_warning() {
    in_container || return 0
    say "$PROG: this looks like a container, not a devbox."
    say ""
    say "  What follows describes this container. The gateway probed is the"
    say "  container's own, any credential found is what is mounted here, and"
    say "  the verdict is about the container's egress rather than the VM's."
    say ""
    say "  For a reading about the devbox, install this with"
    say "  dejima-devbox-bootstrap and run it there. Continuing anyway."
    say ""
}

main() {
    container_warning
    case "${1:-all}" in
        reach)  cmd_reach ;;
        radius) cmd_radius ;;
        all)    cmd_radius; cmd_reach ;;
        *)      say "usage: $PROG [reach|radius]"; return 64 ;;
    esac
}

# Run only when executed, so test/audit.bats can source this and replace the
# two functions that touch the outside world. The :- guard matters under
# set -u: a shell without BASH_SOURCE would otherwise abort here rather than
# fall through to doing nothing.
if [ "${BASH_SOURCE[0]:-$0}" = "$0" ]; then
    main "$@"
fi
