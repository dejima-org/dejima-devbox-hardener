# Proxmox VM firewall for a dejima devbox, as the file Proxmox itself writes
# to /etc/pve/firewall/<vmid>.fw.
#
# REFERENCE, not something to install. proxmox/README.md builds this through
# the web console instead, one rule at a time - a runbook you can check as you
# follow it beats a file to drop onto a hypervisor. This exists because the
# rules are easier to review in one piece than in a table, and because it can
# say why each one is there.
#
# Substitute the placeholders if you do use it directly.
#
# For more than one devbox, prefer a security group: the same rules, defined
# once at datacenter level and referenced by each VM, so the ordering below is
# got right in one place and cannot drift between hosts. proxmox/README.md
# section 3 builds it that way. The [OPTIONS] block is NOT part of a group and
# stays per-VM either way.
#
# THIS IS THE BOUNDARY, and on a devbox it is the only one. A CI runner has a
# second: it is rebuilt from a snapshot on a schedule, so anything that gets in
# has until the next rollback. A devbox holds uncommitted work and cannot be
# rolled back on a timer, so nothing reclaims it. What is left is this file,
# applied to the VM's tap device, where the guest cannot reach it.
#
# dejima's own controls inside the container are not a second boundary either.
# They bound what a session reaches; they do not bound what the VM reaches, and
# that is the gap these rules exist to close.
#
# Requires the firewall enabled at datacenter level as well
# (Datacenter -> Firewall -> Options -> Firewall: Yes) AND the Firewall
# checkbox on the VM's network device. Without either, this file is read and
# enforced nowhere - which looks exactly like it working.

[OPTIONS]
enable: 1

# Inbound denies by default. Unlike a CI runner, this VM does offer services
# somebody should reach - you work on it - so the exceptions below are longer
# than a runner's and are the part of this file that grows.
policy_in: DROP

# Outbound ACCEPTs by default, and the LAN is denied explicitly below.
#
# Do not be tempted to invert this - deny outbound, then allow tcp/80, tcp/443
# and udp/123 - because it is wrong twice over.
#
# It breaks things: apt during a first install, and anything else that happens
# to need a port nobody listed. Every such breakage looks like a network fault
# rather than a firewall rule, so each one is found the hard way.
#
# And it buys almost nothing. This VM is assumed to be owned by an attacker
# with root; the guarantee being made is "reaches the internet, not your
# network", not "reaches only three ports". Someone who owns the box tunnels
# over 443 like everyone else, so the port list constrains honest software and
# not them.
#
# Deny-by-default earns its keep where the protected set is enumerable, which
# is what the four DROPs below are. It does not apply to the internet, which
# is not enumerable, and treating it as though it were gets you a rule set
# that looks strict and only gets in the way.
policy_out: ACCEPT

log_level_in: nolog
log_level_out: nolog

# If this VM gets its address by DHCP, it needs the two rules marked DHCP
# below. See the note above them. There is no option to set here.

[RULES]

# --- inbound ----------------------------------------------------------------
# Two lists, not one, and the front door gets the narrower.
#
# The intuition that SSH is the more dangerous of the two is wrong. Both put a
# terminal in front of whoever reaches them, so they do not differ in
# capability. They differ in what stands in front. SSH with public-key auth has
# nothing to guess and nothing to stuff. The front door has a password, and
# basic auth brings no rate limiting, no lockout and no second factor unless
# they are added on purpose. Same capability behind a weaker gate, so the front
# door is the higher-risk service and takes the smaller source range.
#
# Usage lands on that split without anyone forcing it: you administer over SSH
# from whatever device is to hand, and you want the front door for a phone,
# because that is what it is for.
#
# ONE RULE PER SUBNET. Repeat these lines for each. Do not widen the mask to
# cover two networks with one entry - a range spanning both is not two subnets,
# it is every subnet between them.
IN ACCEPT -source __ADMIN_SUBNET__ -p tcp -dport 22 -log nolog
IN ACCEPT -source __FRONT_DOOR_SUBNET__ -p tcp -dport __FRONT_DOOR_PORT__ -log nolog

# DHCP: omit this and the OUT rule below if the address is static in the guest.
#
# The reply to a lease request arrives from the server's own address to this
# VM's, which is not the tuple the request created - the request went to the
# server, or to 255.255.255.255 when rebinding. Connection tracking is
# unlikely to match it against policy_in: DROP, so without this line the reply
# is dropped and the lease is never renewed.
#
# This lets anything on the segment send to the client port, which is a
# spoofed-reply surface. It is close to free: DHCP on a LAN is
# trust-on-first-use for every host on that segment whatever the firewall does,
# so a rule permitting the reply does not create the exposure.
IN ACCEPT -p udp -dport 68 -log nolog

# --- the two LAN exceptions -------------------------------------------------
# ORDER MATTERS: these must come before the DROPs below, because first match
# wins and both of these addresses are inside the ranges those DROPs cover.
# The console appends new rules at the bottom, so adding them in this order is
# the whole trick.
#
# These are the entire remaining LAN exposure, and they are why "no LAN
# access" is not literally true: you cannot push without the forge, and the
# forge's name cannot resolve without a resolver.
#
# Two hosts, however many ports. Everything else on your network is dropped
# below, and every addition here should be weighed against that sentence
# staying short enough to read.
OUT ACCEPT -dest __FORGE_IP__ -p tcp -dport 443 -log nolog
# A devbox pushes over SSH. A CI runner only ever talked to the API, which is
# why this line has no counterpart there.
OUT ACCEPT -dest __FORGE_IP__ -p tcp -dport 22 -log nolog
OUT ACCEPT -dest __RESOLVER_IP__ -p udp -dport 53 -log nolog
OUT ACCEPT -dest __RESOLVER_IP__ -p tcp -dport 53 -log nolog

# DHCP: omit this and the IN rule above if the address is static in the guest.
#
# A DHCP server almost always sits inside one of the four ranges dropped
# below, so a unicast renewal at T1 is dropped without this. It names a port
# and no host, which makes it narrower than an exception naming the server's
# address: it adds no reachable host to the list above.
#
# Do not rely on rebinding instead. At T2 the client stops unicasting and
# broadcasts to 255.255.255.255, which none of the DROPs match, so the request
# leaves - but see the IN rule above for why the reply does not come back.
# Both halves are needed or neither is.
OUT ACCEPT -p udp -dport 67 -log nolog

# --- everything else on your network ----------------------------------------
# The four lines the whole VM exists to make true.
OUT DROP -dest 10.0.0.0/8 -log nolog
OUT DROP -dest 172.16.0.0/12 -log nolog
OUT DROP -dest 192.168.0.0/16 -log nolog
# Link-local, which includes cloud metadata services at 169.254.169.254.
OUT DROP -dest 169.254.0.0/16 -log nolog

# Nothing follows. The public internet is reached by the default policy, not
# by a list of ports - see the note on policy_out above.
